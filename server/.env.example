# API configuration. Copy to `.env` for local development and load it however you prefer
# (`node --env-file=.env dist/index.js`, direnv, or your shell).
#
# In production every one of these is set by the Cloud Run service definition in
# terraform/cloudrun.tf — except the secrets (the two OAuth client secrets, BETTER_AUTH_SECRET, and
# the database password inside DATABASE_URL), which are mounted from Secret Manager and never pass
# through CI or this file.

# Port to listen on. Cloud Run injects its own; 5066 matches VITE_DEV_API_TARGET so the frontend's
# dev proxy finds it without extra configuration.
PORT=5066

# GCS bucket holding the site's markdown and images, and the object prefix everything sits under.
# The content moved here from nwrks-assets-prod (NukaWorks Prod) in August 2026; the old bucket is
# gone. Do not change GCS_PREFIX — published markdown keeps the public paths it has always had.
GCS_BUCKET=hisuiki-assets-prod
GCS_PREFIX=static

# Public CDN host in front of that bucket. Rendered markdown points its images here. Leave empty to
# fall back to storage.googleapis.com directly, which is usually what you want offline.
CDN_BASE_URL=https://cdn.hisuiki.com

# Comma-separated. Doubles as the CORS allow-list and better-auth's trusted-origin list — an origin
# outside these is refused as a post-sign-in redirect, so the flow can't become an open redirect.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://hisuiki.com

# Postgres, through the pg driver adapter. Production DATABASE_URL points to the PgBouncer sidecar:
#   postgresql://USER:PASSWORD@127.0.0.1:6432/hisuiki
# Prisma migrations use a separate direct Cloud SQL unix socket URL so schema operations never pass
# through transaction pooling:
#   DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@localhost/hisuiki?host=/cloudsql/PROJECT:REGION:INSTANCE
# Prisma 7 does not read this file by itself — export the variable, or run the CLI through
# `node --env-file=.env`, before `pnpm --filter aboutme-server migrate`.
DATABASE_URL=
DIRECT_DATABASE_URL=

# better-auth. BETTER_AUTH_URL is the public origin callbacks come back to, and must match what is
# registered with GitHub and Google. BETTER_AUTH_SECRET signs session cookies: generate one with
# `openssl rand -base64 32` and keep it out of this file.
BETTER_AUTH_URL=http://localhost:5173

# Which half of the app this process serves: "api", "web", or "combined" (the default, and what you
# want locally). Production runs the same image twice, once in each role.
APP_ROLE=combined

# Domain the session cookie is scoped to, so a cookie issued by api.hisuiki.com is sent by
# hisuiki.com. Leave empty locally, where both halves are localhost.
#   AUTH_COOKIE_DOMAIN=.hisuiki.com
AUTH_COOKIE_DOMAIN=
BETTER_AUTH_SECRET=
AUTH_APP_NAME=Hisuiki

# OAuth apps for the two social providers. Their callback URLs are
# <BETTER_AUTH_URL>/api/auth/callback/github and .../callback/google.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated email addresses that may moderate: delete anyone's photo or comment. Identified by
# address rather than by provider, so the same person moderates whichever way they signed in.
SITE_OWNER_EMAILS=

# Storage credentials are deliberately absent: the API authenticates to GCS through Application
# Default Credentials. Locally that means `gcloud auth application-default login`; on Cloud Run it
# resolves to the service's own service account, so no key exists to leak.

# Photo gallery limits. Any signed-in account may post, so these are what bound the cost of that:
# the upload cap is per object (a post stores a full image and a thumbnail), and the two rate
# limits are per account per hour, counted per instance.
PHOTOS_MAX_UPLOAD_BYTES=8388608
PHOTOS_MAX_POSTS_PER_HOUR=12
PHOTOS_MAX_COMMENTS_PER_HOUR=60
