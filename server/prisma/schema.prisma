// better-auth's data model. These four tables are the library's own contract — it reads and writes
// them by name — so they are not designed here, they are transcribed from the installed version's
// own table definitions (@better-auth/core's getAuthTables). Do not edit them from memory: a single
// missing column fails at runtime, inside a sign-in, rather than at build time.
//
// Post metadata is not here yet: it still lives as JSON in the assets bucket, behind
// src/services/photos.ts. Moving it is a separate change.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts a connection URL here. Migrations read it from prisma.config.ts, and
// the runtime client gets it through the pg driver adapter in src/services/prisma.ts.
datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Hisuiki's own relations. better-auth never touches these; it only ever inserts and reads the
  // columns above.
  profile      Profile?
  posts        Post[]
  comments     Comment[]
  likes        Like[]
  reposts      Repost[]
  profilePages ProfilePage[]
  boards       Board[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

// One row per sign-in method on an account: a GitHub or Google link, or the local password itself.
// `password` is null for social links, and the OAuth token columns are null for a local account.
//
// `issuer` identifies the identity provider that vouched for the account, and is half of the unique
// key: the same accountId from two different issuers is two different people.
model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ── Hisuiki's own model ────────────────────────────────────────────────────────────────────────
//
// Everything below is the application's, not better-auth's. The columns added to User are all
// nullable or defaulted on purpose: better-auth inserts rows knowing only its own fields, so a
// required column without a default would break every sign-up.

/// One person's public presence: the handle their subdomain is built from, and how their pages look.
model Profile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Subdomain label — emi.hisuiki.com. Lowercase, unique, and separate from the account's display
  /// name so someone can be "Emi (powerm1nt)" at emi.hisuiki.com without the two being tied.
  handle   String? @unique
  headline String?
  bio      String?

  /// Sanitised at write time and scoped to this profile's own container at render, so a stylesheet
  /// cannot restyle the app chrome or another person's content.
  customCss String?

  /// Object paths in the data bucket, not URLs, so the serving host can change without a rewrite.
  wallpaperPath String?
  avatarPath    String?
  accentColor   String?

  /// Extra links this person adds to the header, as [{ label, href }]. JSON rather than a table:
  /// it is a short ordered list that is always read and written whole.
  headerLinks Json @default("[]")

  /// Links shown on the profile itself, same shape as headerLinks and kept separate because the two
  /// serve different purposes: navigation versus "here is where else I am".
  profileLinks Json @default("[]")

  /// Shown publicly, so it is a field the person opts into rather than their account address.
  publicEmail String?
  location    String?
  pronouns    String?

  /// Legacy one-profile layout, retained so the board migration has a durable source. New writes go
  /// to Board.layout; remove this after every deployed database has run the board migration.
  layout Json @default("{}")

  /// The "{name}'s profile" entry in the header. Users can remove it, hence the flag.
  showProfileLink Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profile")
}

/// A post: markdown with a limited HTML subset, optionally carrying media.
///
/// Media posts and written articles are one model rather than two. They differ only in whether
/// there are attachments and whether a title was given, and every feature that matters — comments,
/// likes, reposts, the feed — applies identically to both.
model Post {
  id       String @id
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// Set for articles, so they get a readable URL on the author's profile. Null for media posts.
  slug  String?
  title String?

  /// Object path of the markdown source in the data bucket, e.g. "{userId}/posts/{id}.md".
  ///
  /// The source is not stored in this column. It lives in the bucket because the bucket versions it
  /// — which is what gives a post an edit history — and because a user's own files should stay
  /// files they can fetch, keep, or move. The row holds the pointer and the metadata worth querying.
  bodyPath     String?
  /// Retained only so a database this change could not read cannot lose content. Nothing writes it;
  /// drop it once every row has a bodyPath. See the post_body_to_bucket migration.
  body         String?
  /// Sanitised output, cached so a feed of fifty posts is not fifty markdown renders plus fifty
  /// bucket reads. Rebuilt whenever the source is written.
  renderedHtml String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  media    PostMedia[]
  comments Comment[]
  likes    Like[]
  reposts  Repost[]

  @@unique([authorId, slug])
  @@index([publishedAt])
  @@map("post")
}

/// One image on a post. Paths point into the data bucket under the owning user's prefix.
model PostMedia {
  id     String @id
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  path      String
  thumbPath String?
  width     Int     @default(0)
  height    Int     @default(0)
  alt       String  @default("")
  position  Int     @default(0)

  @@index([postId])
  @@map("post_media")
}

model Comment {
  id       String @id
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body      String
  createdAt DateTime @default(now())

  @@index([postId])
  @@map("comment")
}

/// Keyed by the pair, so liking twice is impossible rather than merely discouraged.
model Like {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
  @@map("like")
}

/// Sharing someone else's post onto your own profile, optionally with a remark of your own.
model Repost {
  id       String @id
  userId   String
  postId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@map("repost")
}

/// A page the user writes for their own profile — an about page, a links page, anything.
/// `isHome` replaces the default profile landing, which is how a profile overrides app behaviour.
model ProfilePage {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug         String
  title        String
  /// Object path of the markdown source in the data bucket, as on Post.
  bodyPath     String?
  /// Retained for the same reason as Post.body.
  body         String?
  renderedHtml String?
  isHome       Boolean @default(false)
  /// Whether the page appears in the profile's own navigation, and in what order.
  inNav    Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
  @@map("profile_page")
}

/// A publishable experience made from widgets.
///
/// Boards are separate from Profile because one person may create many experiences. A primary
/// board is the one shown at /users/{handle}; the others have their own slug beneath that profile.
/// Layout remains JSON because it is an editor-owned document that is always read and written whole.
model Board {
  id      String @id
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  slug        String
  title       String
  description String @default("")
  layout      Json   @default("{}")

  isPrimary  Boolean  @default(false)
  /// When set, this board supplies the widget layout for one standalone website page. Null for
  /// ordinary user experiences. This is an optional override of the protected system board.
  sitePage    String?  @unique
  /// The canonical editable board for a website route. Exactly one is created for each supported
  /// page when a site owner opens Admin; unlike an override, it cannot be unpublished or deleted.
  systemPage  String?  @unique
  publishedAt DateTime?
  viewCount   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, slug])
  @@index([ownerId, isPrimary])
  @@index([publishedAt, viewCount])
  @@map("board")
}

/// Settings that belong to the site rather than to any one person. One row per key.
model SiteSetting {
  key   String @id
  /// Free-form: what a key means is decided by whoever reads it.
  value Json
  updatedAt DateTime @updatedAt
}
