{
  "name": "hisuiki-server",
  "version": "2.1",
  "description": "Hisuiki board platform API",
  "private": true,
  "type": "module",
  "main": "dist/Server.js",
  "scripts": {
    "generate": "prisma generate",
    "dev": "prisma generate && tsx watch src/Server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "migrate": "prisma migrate deploy",
    "test:security": "tsx test/UserContent.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.7.1",
    "express": "^5.2.1",
    "marked": "^18.0.9",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
