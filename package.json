{
  "name": "hisuiki-web",
  "version": "2.1",
  "description": "Hisuiki — board experience sharing platform",
  "repository": "https://github.com/powerm1nt/Hisuiki",
  "homepage": "https://hisuiki.com",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "symbols": "node scripts/SearchSymbols.mjs",
    "test:layout": "tsx scripts/WidgetTreeUtils.test.ts",
    "e2e": "node scripts/EndToEnd.mjs",
    "e2e:inspector": "node scripts/InspectorLayers.e2e.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "better-auth": "^1.7.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "webamp": "^2.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "playwright": "^1.62.1",
    "sass": "^1.102.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
